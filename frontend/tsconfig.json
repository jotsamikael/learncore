/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "ckeditor5/src/core": ["node_modules/ckeditor5/src/core.js"],
      "ckeditor5/src/ui": ["node_modules/ckeditor5/src/ui.js"],
      "ckeditor5/src/utils": ["node_modules/ckeditor5/src/utils.js"],
      "ckeditor5/src/engine": ["node_modules/ckeditor5/src/engine.js"],
      "ckeditor5/src/widget": ["node_modules/ckeditor5/src/widget.js"],
      "ckeditor5/src/clipboard": ["node_modules/ckeditor5/src/clipboard.js"],
      "ckeditor5/src/undo": ["node_modules/ckeditor5/src/undo.js"]
    },
    "outDir": "./dist/out-tsc",
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "node",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "useDefineForClassFields": false,
    "lib": [
      "ES2022",
      "dom"
    ],
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
